# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/inmobia
DIRECT_URL=postgresql://postgres:password@localhost:5432/inmobia

# ─── Auth ─────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=cambiar_por_string_aleatorio_de_minimo_32_chars
BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── IA / LLM ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                    # para embeddings Voyage-3 o fallback
VOYAGE_API_KEY=                    # embeddings Voyage-3

# ─── Storage (Cloudflare R2) ──────────────────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=inmobia-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.inmobia.com

# ─── Cache / Colas ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@inmobia.com

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:3001
ML_SERVICE_URL=http://localhost:8000
NODE_ENV=development
